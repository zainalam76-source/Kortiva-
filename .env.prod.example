# Copy to .env.prod and fill in real values before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build

POSTGRES_USER=kortiva
POSTGRES_PASSWORD=change-me-to-a-strong-random-password
POSTGRES_DB=kortiva

# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=12h

# Public URLs your users will actually hit — behind whatever reverse
# proxy / domain you put in front of this stack.
API_PUBLIC_URL=https://api.yourdomain.com
WIDGET_PUBLIC_URL=https://book.yourdomain.com
CORS_ORIGINS=https://admin.yourdomain.com,https://book.yourdomain.com

# --- Payment gateways — leave blank until real merchant credentials exist ---
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
STRIPE_SECRET_KEY=

# --- WhatsApp — leave blank until Meta Business verification completes ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
